{
  "functions": {
    "api/admin/blob-upload.js": {
      "includeFiles": "node_modules/@vercel/blob/dist/**"
    }
  },
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
